# Copier ce fichier en .env et remplir les vraies valeurs (ne jamais committer .env)

# Serveur
PORT=3000
NODE_ENV=development

# Base de données PostgreSQL (+ PostGIS)
DB_HOST=localhost
DB_PORT=5432
DB_USER=souk
DB_PASSWORD=souk_dev_password
DB_NAME=souk_db

# Redis (cache + files d'attente)
REDIS_HOST=localhost
REDIS_PORT=6379

# Auth
JWT_SECRET=change_moi_en_production
JWT_EXPIRES_IN=7d

# SMS OTP (à remplacer par le fournisseur choisi)
SMS_PROVIDER_API_KEY=

# Mobile Money (à remplacer une fois le fournisseur confirmé avec Airtel/Moov)
AIRTEL_MONEY_API_KEY=
MOOV_MONEY_API_KEY=

# Stockage médias (S3-compatible)
S3_ENDPOINT=
S3_BUCKET=souk-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
